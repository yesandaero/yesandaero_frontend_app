{
  "expo": {
    "name": "yesandaero_frontend",
    "slug": "yesandaero_frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "yesandaerofrontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "현재 위치를 기준으로 가까운 가게를 찾기 위해 위치 권한이 필요합니다."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "쿠폰 QR을 스캔하기 위해 카메라 권한이 필요합니다.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
